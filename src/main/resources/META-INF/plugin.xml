<idea-plugin>
    <id>com.zuozhi.ideaannotation</id>
    <name>IDEA Annotation</name>
    <vendor>zuozhi</vendor>
    <description><![CDATA[
        Select local text, add an optional comment, and copy a source-aware Markdown annotation.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <editorFactoryListener implementation="com.zuozhi.ideaannotation.AnnotationEditorFactoryListener"/>
    </extensions>

    <actions resource-bundle="messages.IdeaAnnotationBundle">
        <action
            id="com.zuozhi.ideaannotation.CopyAnnotationAction"
            class="com.zuozhi.ideaannotation.CopyAnnotationAction"
            icon="AllIcons.Actions.Edit">
            <add-to-group
                group-id="Floating.CodeToolbar"
                anchor="after"
                relative-to-action="ReformatCode"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
