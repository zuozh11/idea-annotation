<idea-plugin>
    <id>com.zuozhi.ideaannotation</id>
    <name>Selection Annotation</name>
    <vendor url="https://github.com/zuozh11" email="zuozhi22@outlook.com">zuozhi</vendor>
    <description><![CDATA[
        Copy a selected code or text fragment as a source-aware Markdown annotation.
        <ul>
            <li>Open the annotation input from the floating code toolbar or editor context menu.</li>
            <li>Include the absolute source path and selected line range automatically.</li>
            <li>Add an optional multiline comment and copy the result to the clipboard.</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <editorFactoryListener implementation="com.zuozhi.ideaannotation.AnnotationEditorFactoryListener"/>
    </extensions>

    <actions resource-bundle="messages.IdeaAnnotationBundle">
        <action
            id="com.zuozhi.ideaannotation.CopyAnnotationAction"
            class="com.zuozhi.ideaannotation.CopyAnnotationAction"
            icon="AllIcons.Actions.Edit">
            <add-to-group
                group-id="Floating.CodeToolbar"
                anchor="after"
                relative-to-action="ReformatCode"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
